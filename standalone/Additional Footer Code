<script>
(function(){
var ITEMS=[["niche","Niche Travel Guides","/guides#niche"],["dest","Destination Guides","/guides#dest"],["howto","How-To Guides","/guides#howto"]];
var observing=false;
function isGuides(h){ if(!h) return false; if(h.slice(-7)==="/guides") return true; if(h.slice(-8)==="/guides/") return true; return false; }
function removeOpen(c){ return c.split(" ").filter(function(x){return x!=="igp-open";}).join(" "); }
function build(){
 var bar=document.querySelector(".homepage_button_links"); if(!bar) return;
 var links=[].slice.call(bar.querySelectorAll("a")); var btn=null;
 for(var i=0;i<links.length;i++){ if(isGuides(links[i].getAttribute("href"))){ btn=links[i]; break; } }
 if(!btn) return;
 var col=btn.parentElement; if(!col) return;
 if(col.querySelector(".igp-guides-sub")) return;
 if(col.className.indexOf("igp-guides-wrap")===-1){ col.className+=" igp-guides-wrap"; }
 var sub=document.createElement("div"); sub.className="igp-guides-sub";
 for(var j=0;j<ITEMS.length;j++){
  var a=document.createElement("a"); a.className="igp-guides-link igp-g-"+ITEMS[j][0]; a.setAttribute("href",ITEMS[j][2]);
  var ic=document.createElement("i"); ic.setAttribute("aria-hidden","true");
  var sp=document.createElement("span"); sp.textContent=ITEMS[j][1];
  a.appendChild(ic); a.appendChild(sp); sub.appendChild(a);
 }
 col.appendChild(sub);
 var caret=document.createElement("button"); caret.type="button"; caret.className="igp-guides-caret";
 caret.setAttribute("aria-label","Show guide categories"); caret.setAttribute("aria-expanded","false");
 caret.innerHTML="&#9660;";
 caret.onclick=function(ev){ ev.preventDefault(); ev.stopPropagation();
  var open=col.className.indexOf("igp-open")===-1;
  col.className=open?(col.className+" igp-open"):removeOpen(col.className);
  caret.setAttribute("aria-expanded",open?"true":"false"); };
 col.appendChild(caret);
 function closeIt(){ col.className=removeOpen(col.className); caret.setAttribute("aria-expanded","false"); }
 document.addEventListener("click",function(ev){ if(!col.contains(ev.target)) closeIt(); });
 document.addEventListener("keydown",function(ev){ if(ev.key==="Escape") closeIt(); });
 if(!observing && window.MutationObserver){ observing=true;
  new MutationObserver(function(){ if(!document.querySelector(".igp-guides-sub")) build(); }).observe(bar,{childList:true,subtree:true}); }
}
if(document.readyState==="loading"){ document.addEventListener("DOMContentLoaded",build); } else { build(); }
setTimeout(build,700); setTimeout(build,2200); setTimeout(build,4000);
window.addEventListener("load",build);
})();
</script>
<script>
(function () {
  var KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];
  var COOKIE = 'igp_utm';
  var DAYS = 30;
  function readCookie() {
    var m = document.cookie.match(new RegExp('(?:^|; )' + COOKIE + '=([^;]*)'));
    if (!m) { return null; }
    try { return JSON.parse(decodeURIComponent(m[1])); } catch (e) { return null; }
  }
  function writeCookie(data) {
    var exp = new Date(Date.now() + DAYS * 864e5).toUTCString();
    document.cookie = COOKIE + '=' + encodeURIComponent(JSON.stringify(data)) +
      '; expires=' + exp + '; path=/; SameSite=Lax';
  }
  var params = new URLSearchParams(window.location.search);
  if (params.get('utm_source')) {
    var fresh = {};
    KEYS.forEach(function (k) {
      fresh[k] = (params.get(k) || '').trim().toLowerCase().slice(0, 100);
    });
    writeCookie(fresh);
  }
  var stored = readCookie() || {};
  function isPlaceholder(v) {
    return !v || /^utm[ _-]?(source|medium|campaign|content)$/i.test(v.trim());
  }
  function fill(root) {
    KEYS.forEach(function (k) {
      var inputs = (root || document).querySelectorAll('input[name="' + k + '"]');
      for (var i = 0; i < inputs.length; i++) {
        if (isPlaceholder(inputs[i].value)) { inputs[i].value = stored[k] || ''; }
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { fill(); });
  } else {
    fill();
  }
  if (window.MutationObserver) {
    var pending = false;
    new MutationObserver(function () {
      if (pending) { return; }
      pending = true;
      setTimeout(function () { pending = false; fill(); }, 200);
    }).observe(document.documentElement, { childList: true, subtree: true });
  }
  document.addEventListener('submit', function (e) { fill(e.target); }, true);
})();
</script>
